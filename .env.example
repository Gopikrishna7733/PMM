# ==============================================================================
# Pharmaceutics Mastery Matrix (PMM) — Environment Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Runtime
PMM_ENV=development
PMM_PORT=8080
PMM_APP_NAME="Pharmaceutics Mastery Matrix"
PMM_APP_VERSION="1.0.0"
PMM_APP_URL="http://localhost:8080"

# Feature Flags
USE_SUPABASE=false
USE_MOCK_AUTH=true

# Supabase Credentials (Phase 2)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Database Connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Seed Demo Account
DEMO_SCHOLAR_EMAIL=scholar@pmm.edu
DEMO_SCHOLAR_PASSWORD=Mastery2026!

# AI & LLM Services
GEMINI_API_KEY="your-gemini-api-key"

